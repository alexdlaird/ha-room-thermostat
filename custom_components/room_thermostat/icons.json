{
  "entity": {
    "select": {
      "active_room": {
        "default": "mdi:home-thermometer"
      }
    },
    "sensor": {
      "room_offset": {
        "default": "mdi:thermometer-minus"
      },
      "room_error": {
        "default": "mdi:target"
      },
      "commanded_heat": {
        "default": "mdi:fire"
      },
      "commanded_cool": {
        "default": "mdi:snowflake"
      },
      "control_state": {
        "default": "mdi:state-machine"
      },
      "hold_ends": {
        "default": "mdi:timer-sand"
      },
      "schedule": {
        "default": "mdi:calendar-clock",
        "state": {
          "not_configured": "mdi:calendar-blank-outline",
          "not_found": "mdi:calendar-alert"
        }
      },
      "sensor_issues": {
        "default": "mdi:thermometer-alert"
      }
    },
    "button": {
      "resume": {
        "default": "mdi:play"
      }
    }
  }
}
